# Optional overrides. Secrets (LLM keys, bot tokens) are stored encrypted
# in the local SQLite settings — do not put them here.

# Path to the SQLite database (default: ~/.automessage/automessage.db)
# AUTOMESSAGE_DB_PATH=~/.automessage/automessage.db

# HTTP port (default: 8741)
# AUTOMESSAGE_PORT=8741

# Bind host (default: 127.0.0.1)
# AUTOMESSAGE_HOST=127.0.0.1

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# AUTOMESSAGE_LOG_LEVEL=INFO

# Skip opening the browser on `automessage start` (default: false)
# AUTOMESSAGE_OPEN_BROWSER=false

# Directory for the Fernet key used to encrypt credentials at rest
# (default: ~/.automessage)
# AUTOMESSAGE_DATA_DIR=~/.automessage
